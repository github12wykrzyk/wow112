+/* No CRT: x87 FSINCOS keeps the rear-sector calculation self-contained on x86. */
+static void SinCosF(float a,float*s,float*c)
+{
+    __asm {
+        fld a
+        fsincos
+        mov eax,c
+        fstp dword ptr [eax]
+        mov eax,s
+        fstp dword ptr [eax]
+    }
+}
