{
  "schema_version": 1,
  "purpose": "Machine-readable fast routing for one canonical main integration world. Optimized for minimum ChatGPT interface latency.",
  "target": {
    "game": "World of Warcraft",
    "version": "1.12.1",
    "build": 5875,
    "platform": "Windows",
    "architecture": "x86"
  },
  "branches": {
    "canonical": "main",
    "development": "main",
    "stable": "main",
    "delivery_alias": "parallel",
    "delivery_pointer": "parallel-testpoint",
    "legacy_compatibility": [
      "work"
    ],
    "promotion_pattern": "promote/**",
    "feature_pattern": "feature/**"
  },
  "read_order": [
    "AGENTS.md",
    "AI_START_HERE.md",
    "AI_INDEX.json",
    "CURRENT.json",
    "runtime/current.json"
  ],
  "conditional_fast_indexes": {
    "shared_native_primitives": "runtime/verified_symbols_5875.json",
    "startup_context": "runtime/ai_startup_snapshot.json"
  },
  "canonical": {
    "operating_contract": "AGENTS.md",
    "current_state": "CURRENT.json",
    "runtime_manifest": "runtime/current.json",
    "verified_symbols_registry": "runtime/verified_symbols_5875.json",
    "exact_artifact_registry": "runtime/exact_artifacts.json",
    "source_root": "src",
    "source_inventory": "docs/SOURCE_INVENTORY.md",
    "baseline_root": "baseline",
    "manifest_root": "manifests",
    "project_rules": "PROJECT_INSTRUCTIONS.md",
    "runtime_binary_cache": "artifacts/runtime_cache",
    "runtime_packager": "tools/package_current.py",
    "exact_stable_packager": "tools/package_exact_current.py",
    "final_package_verifier": "tools/verify_candidate_package.py",
    "active_builder": "tools/build_active_module.py",
    "candidate_builder": "tools/build_changed_active.py",
    "source_metadata_sync": "tools/sync_source_metadata.py",
    "promotion_workflow": ".github/workflows/pre_promote_stable.yml",
    "experiment_registry": "runtime/ai_experiments.json",
    "experiment_workflow": ".github/workflows/ai_experiments.yml",
    "parallel_candidate_manifest": "runtime/parallel_candidate.json",
    "parallel_feature_preflight": ".github/workflows/parallel_feature_preflight.yml",
    "parallel_integration_policy": "runtime/parallel_integration_policy.json",
    "parallel_testpoint_policy": "runtime/parallel_testpoint_policy.json",
    "thread_policy": "runtime/parallel_thread_policy.json",
    "delivery_routing_policy": "runtime/parallel_delivery_routing.json",
    "experiment_fast_index": "runtime/ai_experiment_index.json",
    "startup_snapshot": "runtime/ai_startup_snapshot.json",
    "startup_snapshot_generator": "tools/ai_startup_snapshot.py"
  },
  "commands": {
    "fast_verify": "python tools/verify_current.py",
    "runtime_verify": "python tools/verify_runtime_artifacts.py",
    "verified_symbols_verify": "python tools/verify_verified_symbols.py",
    "deep_verify": "python tools/verify_repo.py",
    "status": "python tools/ai_status.py",
    "status_json": "python tools/ai_status.py --json",
    "task_context": "python tools/ai_task_context_fast.py --branch main --module MODULE",
    "package_current": "python tools/package_current.py --output dist/current.zip --metadata dist/current_metadata.json",
    "package_exact_stable": "python tools/package_exact_current.py --output dist/WoW112_STABLE_CANDIDATE.zip --metadata dist/candidate_metadata.json",
    "finalize_package": "python tools/verify_candidate_package.py --package dist/WoW112_WORK_CANDIDATE.zip --package-metadata dist/candidate_metadata.json --summary dist/candidate_summary.json --finalize",
    "build_active_list": "python tools/build_active_module.py --list",
    "build_active_one": "python tools/build_active_module.py --name <runtime-dll-name>",
    "build_changed_candidate": "python tools/build_changed_active.py --base <previous-git-sha> --package dist/WoW112_WORK_CANDIDATE.zip --package-metadata dist/candidate_metadata.json",
    "sync_source_metadata": "python tools/sync_source_metadata.py",
    "check_source_metadata": "python tools/sync_source_metadata.py --check",
    "validate_experiments": "python tools/ai_experiments.py validate",
    "parallel_feature_preflight": "python tools/parallel_feature_preflight.py --base origin/main",
    "generate_experiment_fast_index": "python tools/ai_experiments.py index",
    "check_experiment_fast_index": "python tools/ai_experiments.py index --check",
    "generate_startup_snapshot": "python tools/ai_startup_snapshot.py",
    "check_startup_snapshot": "python tools/ai_startup_snapshot.py --check"
  },
  "directories": {
    "src": "canonical editable source/evidence grouped by module",
    "runtime": "machine-readable runtime/task metadata; do not enumerate globally on normal tasks",
    "baseline": "stable rollback metadata",
    "manifests": "reference hashes",
    "artifacts/runtime_cache": "content-addressed exact DLL bytes",
    "artifacts": "recovery/binary evidence; inspect only when required",
    "archives": "historical/recovery; do not scan by default",
    "source": "legacy/historical material only",
    "docs": "workflow/provenance documentation",
    "tools": "verification/build/packaging scripts"
  },
  "do_not_scan_by_default": [
    "archives",
    "src/history",
    "source/V20_SOURCE_PARTS",
    "artifacts/V67",
    "runtime/parallel_tasks",
    "runtime/ai_experiments.json",
    "runtime/ai_experiment_index.json"
  ],
  "rules": [
    "main is the canonical integration/development trunk",
    "parallel is an exact compatibility/delivery alias",
    "ordinary work starts on feature/** from current main",
    "resolve main once and trust the generated startup snapshot on the ordinary chat success path",
    "do not read the experiment index or full ledger unless explicit continuation or unresolved routing ambiguity requires it",
    "open known owner paths directly; broad search is fallback only",
    "one logical multi-file iteration should be one Git tree commit",
    "integration attempts use optimistic atomic CAS against live main; there is no serialized pending-slot queue",
    "post-integration delivery is fail-closed path/risk routed",
    "heavy repository audits are scheduled/manual/PR/release",
    "do not poll successful CI from chat; the integration workflow waits for exact-SHA downstream delivery",
    "progress messages are blocker-only unless the user explicitly asks for them",
    "PREFLIGHT PASS is not TEST READY",
    "AI owns routine GitHub housekeeping"
  ],
  "chat_execution_policy": {
    "default_communication": "final_only",
    "progress_updates": "only_explicit_request_or_real_blocker",
    "api_calls_for_ping": false,
    "ref_resolution": "once_per_phase_unless_known_state_change",
    "refetch_unchanged_files": false,
    "successful_ci_logs": "do_not_read",
    "ci_polling": "no_subjob_polling; inspect latest top-level exact-SHA run only when needed"
  },
  "startup_fast_path": {
    "schema_version": 1,
    "snapshot": "runtime/ai_startup_snapshot.json",
    "source_files": [
      "AGENTS.md",
      "AI_START_HERE.md",
      "AI_INDEX.json",
      "CURRENT.json",
      "runtime/current.json"
    ],
    "verification": {
      "method": "CI/recovery may compare snapshot git_blob_sha1 values with Git tree metadata from the same main HEAD",
      "same_head_required": true,
      "fallback_if_unverifiable": true,
      "ordinary_chat_policy": "trust the generated snapshot from live canonical main; do not hash-verify five sources per ordinary task"
    },
    "eligible_tasks": [
      "ordinary module/feature diagnosis",
      "ordinary implementation from canonical main through feature/**",
      "CI/status follow-up where startup authority is unchanged"
    ],
    "full_startup_required_for": [
      "release or promote/** work",
      "editing startup source/snapshot/generator",
      "recovery after ambiguous write/transport state",
      "snapshot explicitly reported stale/mismatched",
      "authority ambiguity unresolved by current main/snapshot"
    ],
    "after_verified_snapshot": [
      "resolve current main HEAD once before writing",
      "open only the named/known owner files",
      "use experiment/task routing only for explicit continuation or unresolved ambiguity",
      "implement before broadening analysis unless a concrete risk is unresolved"
    ],
    "invariants": [
      "main is canonical integration authority",
      "parallel is an exact delivery alias",
      "work is not a normal development target",
      "optimistic CAS arbitrates concurrent integration attempts",
      "one logical iteration uses one coherent commit when possible",
      "heavy audits stay outside the ordinary hot path",
      "branch/history/archive/task-ledger archaeology is failure-driven, not default",
      "chat progress/polling must not create extra API traffic"
    ]
  }
}
