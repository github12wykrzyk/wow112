* text=auto

# Canonical source and metadata must keep deterministic LF bytes.
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.patch text eol=lf

# Windows helper scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Runtime artifacts are binary.
*.dll binary
*.exe binary
*.xz binary
*.zip binary
