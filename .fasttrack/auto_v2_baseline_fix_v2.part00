                 _=>continue,
             };
+            if let UpdateMask::Player(p)=mask { if guid==s.player {
+                // Authoritative per-slot item GUIDs (ItemSlot 0..112). Partial GUIDs are uncertainty.
+                let mut slots=[None;LIFECYCLE_INV_SLOTS];
+                let mut garbled=false;
