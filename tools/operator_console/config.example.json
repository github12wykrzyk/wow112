{
  "schema_version": 1,
  "history": {
    "directory": "%LOCALAPPDATA%\\WoW112\\OperatorConsole\\history",
    "format": "jsonl",
    "rotate_bytes": 16777216,
    "keep_files": 10
  },
  "bridge": {
    "directory": "%LOCALAPPDATA%\\WoW112\\OperatorConsole\\bridge",
