from pathlib import Path
import base64
import lzma

base = Path("artifacts")
prefix = "WoWPlayerESP_v1_2_range_sweep.c.xz.b64.part"
b64 = b"".join((base / (prefix + "%03d" % i)).read_bytes() for i in range(5))
source = lzma.decompress(base64.b64decode(b64))
Path("WoWPlayerESP_v1_2_range_sweep.c").write_bytes(source)
